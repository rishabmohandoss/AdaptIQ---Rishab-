NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://adaptiq:password@localhost:5432/adaptiq
# For RDS: true, with the AWS RDS CA bundle path below. Never disable verification.
DATABASE_SSL=false
DATABASE_CA_FILE=
GOOGLE_CLIENT_ID=
AWS_REGION=us-east-1
RESUME_BUCKET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Jev uses the official TypeSafe API; JEV_API_KEY is also accepted.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
# Initial policy threshold; validate against representative practice recordings.
JEV_CONFIDENCE_THRESHOLD=0.75
FIREBASE_PROJECT_ID=adaptiq-fa584
REVIEW_PORT=3001
# Set to a Live audio model available to your Gemini project to enable optional practice.
GEMINI_LIVE_MODEL=
# Private persistent EC2/EBS directory, NOT under a web root.
RECORDINGS_DIR=./data/recordings
