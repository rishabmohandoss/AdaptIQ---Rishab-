NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://adaptiq:password@localhost:5432/adaptiq
# For RDS: true, with the AWS RDS CA bundle path below. Never disable verification.
DATABASE_SSL=false
DATABASE_CA_FILE=
GOOGLE_CLIENT_ID=
AWS_REGION=us-east-1
RESUME_BUCKET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Set to a Live audio model available to your Gemini project to enable optional practice.
GEMINI_LIVE_MODEL=
# Private persistent EC2/EBS directory, NOT under a web root.
RECORDINGS_DIR=./data/recordings
