{
  "hosting": {
    "public": "data/review-public",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git",
      ".gitignore",
      ".claude",
      "*.md",
      "demo/**",
      "frontend/**",
      "integration/**",
      "perception/**",
      "PRD-details/**",
      "firestore.rules",
      "firestore.indexes.json",
      "storage.rules"
    ],
    "rewrites": [
      {
        "source": "/app{,/}",
        "destination": "/app.html"
      },
      {
        "source": "/interview{,/}",
        "destination": "/interview.html"
      },
      {
        "source": "/",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
